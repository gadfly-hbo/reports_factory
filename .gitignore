# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo

# flow local machine state (durable artifacts in .flow/*.md ARE committed)
.flow/state.json
.flow/verify-failures.md

# 项目数据随仓库双机同步（对齐 deep-research research-data 全量入库）：
# 工作区/材料/修订/编审状态/导出记录都入库，换机可续作。
# 数据目录（仓库内随双机同步；可再生工件 pptx/pdf 不入库）：
data/*
!data/.keep
!data/*/
# 夹具 PDF/PPTX/SAMPLES golden 必须入库——把豁免放在全局忽略之前（gitignore last-match 语义）
!fixtures/**/*.pptx
!fixtures/**/*.pdf
!samples/**/golden/*.txt
*.pptx
*.pdf
data/*/exports/*.docx
data/*/exports/*.html

# env & logs
.env
.env.*
*.log

# OS
.DS_Store
samples/*.html
samples/**/*.pptx
samples/**/*.pdf
samples/**/page-*.png
web-dist/
# deck 渲染兜底符号链接（R1-5）
data/*/node_modules
